#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
GLOBAL_DIR="$HOME/.claude/agents"

# shellcheck source=../lib/symlinks.sh
source "$REPO_DIR/lib/symlinks.sh"
GITIGNORE_COMMENT="# Claude agents (managed by 'ai agents install')"
GITIGNORE_PATH_PREFIX=".claude/agents/"

usage() {
    cat <<'EOF'
Usage: ai agents <command> [args]

Commands:
  publish [agent-name...] [--from <project-root>] [--all | --interactive]
      Symlink agents from <project-root>/agents/ into ~/.claude/agents/
      Default source: current working directory
      --all            publish all available agents without prompting
      --interactive    prompt for each agent

  install [agent-name...] [--to <project-root>] [--all | --interactive]
      Symlink agents from ~/.claude/agents/ into <project-root>/.claude/agents/
      Default target: current working directory
      --all            install all available agents without prompting
      --interactive    prompt for each agent

  uninstall [agent-name...] [--from <project-root>] [--all | --interactive]
      Remove agent symlinks from <project-root>/.claude/agents/
      Default target: current working directory
      --all            remove all installed agents without prompting
      --interactive    prompt for each agent

  list [--publishable | --installable] [--from <project-root>] [--to <project-root>]
      --publishable            diff: what can be published from the current project
        --from <project-root>  use alternate project as source
      --installable            diff: what can be installed into the current project
        --to <project-root>    use alternate project as target
      (default)                list all agents in ~/.claude/agents/
EOF
}

no_args_hint() {
    local cmd="$1"
    echo "Specify agent names, use --all to $cmd all available agents, or run 'ai agents list' first." >&2
    echo "Run 'ai agents' for full usage." >&2
    exit 1
}

resolve_project_root() {
    local arg="$1"
    if [[ -n "$arg" ]]; then
        cd "$arg" && pwd
    else
        pwd
    fi
}

cmd_publish() {
    local filter=()
    local project_root_arg=""
    local ALL=false
    local i=0
    local args=("$@")

    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[$i]}" in
            --all)         ALL=true ;;
            --interactive) INTERACTIVE=true ;;
            --from)        i=$((i + 1)); project_root_arg="${args[$i]}" ;;
            *)             filter+=("${args[$i]}") ;;
        esac
        i=$((i + 1))
    done

    [[ ${#filter[@]} -gt 0 || "$ALL" == true || "$INTERACTIVE" == true ]] \
        || no_args_hint "publish"

    local base_dir
    base_dir="$(resolve_project_root "$project_root_arg")"
    local agents_src="$base_dir/agents"

    [[ -d "$agents_src" ]] \
        || { echo "Error: no agents/ directory found in $base_dir" >&2; exit 1; }

    mkdir -p "$GLOBAL_DIR"

    local found_any=false
    for agent_file in "$agents_src"/*.md; do
        [[ -f "$agent_file" ]] || continue
        found_any=true
        local filename name
        filename="$(basename "$agent_file")"
        name="${filename%.md}"
        if [[ "$ALL" == false ]]; then
            name_matches "$name" "${filter[@]+"${filter[@]}"}" || continue
        fi
        do_link "$agent_file" "$GLOBAL_DIR/$filename"
    done

    [[ "$found_any" == true ]] || echo "No agents found in $agents_src"
}

cmd_install() {
    local filter=()
    local project_root_arg=""
    local ALL=false
    local i=0
    local args=("$@")

    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[$i]}" in
            --all)         ALL=true ;;
            --interactive) INTERACTIVE=true ;;
            --to)          i=$((i + 1)); project_root_arg="${args[$i]}" ;;
            *)             filter+=("${args[$i]}") ;;
        esac
        i=$((i + 1))
    done

    [[ ${#filter[@]} -gt 0 || "$ALL" == true || "$INTERACTIVE" == true ]] \
        || no_args_hint "install"

    local base_dir
    base_dir="$(resolve_project_root "$project_root_arg")"

    [[ -d "$GLOBAL_DIR" ]] \
        || { echo "Error: global store not found at $GLOBAL_DIR" >&2; exit 1; }

    local target_dir="$base_dir/.claude/agents"
    mkdir -p "$target_dir"

    local found_any=false
    for agent_file in "$GLOBAL_DIR"/*.md; do
        [[ -f "$agent_file" || -L "$agent_file" ]] || continue
        found_any=true
        local filename name
        filename="$(basename "$agent_file")"
        name="${filename%.md}"
        if [[ "$ALL" == false ]]; then
            name_matches "$name" "${filter[@]+"${filter[@]}"}" || continue
        fi
        local target="$target_dir/$filename"
        do_link "$agent_file" "$target"
        [[ -L "$target" ]] && add_gitignore_entry "$base_dir" ".claude/agents/$filename"
    done

    [[ "$found_any" == true ]] || echo "No agents found in $GLOBAL_DIR"
}

cmd_uninstall() {
    local filter=()
    local project_root_arg=""
    local ALL=false
    local i=0
    local args=("$@")

    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[$i]}" in
            --all)         ALL=true ;;
            --interactive) INTERACTIVE=true ;;
            --from)        i=$((i + 1)); project_root_arg="${args[$i]}" ;;
            *)             filter+=("${args[$i]}") ;;
        esac
        i=$((i + 1))
    done

    [[ ${#filter[@]} -gt 0 || "$ALL" == true || "$INTERACTIVE" == true ]] \
        || no_args_hint "uninstall"

    local base_dir
    base_dir="$(resolve_project_root "$project_root_arg")"
    local target_dir="$base_dir/.claude/agents"

    local names=()
    if [[ ${#filter[@]} -gt 0 ]]; then
        names=("${filter[@]}")
    elif [[ -d "$target_dir" ]]; then
        local link
        for link in "$target_dir"/*.md; do
            [[ -L "$link" ]] || continue
            local filename name
            filename="$(basename "$link")"
            name="${filename%.md}"
            names+=("$name")
        done
    fi

    local name
    for name in "${names[@]+"${names[@]}"}"; do
        local target="$target_dir/$name.md"
        do_unlink "$target"
        [[ ! -L "$target" ]] && remove_gitignore_entry "$base_dir" ".claude/agents/$name.md"
    done
}

cmd_list() {
    local publishable=false
    local installable=false
    local project_root_arg=""
    local i=0
    local args=("$@")

    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[$i]}" in
            --publishable) publishable=true ;;
            --installable) installable=true ;;
            --from|--to)   i=$((i + 1)); project_root_arg="${args[$i]}" ;;
        esac
        i=$((i + 1))
    done

    if [[ "$publishable" == true ]]; then
        local base_dir
        base_dir="$(resolve_project_root "$project_root_arg")"
        local agents_src="$base_dir/agents"

        [[ -d "$agents_src" ]] \
            || { echo "Error: no agents/ directory found in $base_dir" >&2; exit 1; }

        local already=()
        local available=()
        for agent_file in "$agents_src"/*.md; do
            [[ -f "$agent_file" ]] || continue
            local filename name
            filename="$(basename "$agent_file")"
            name="${filename%.md}"
            if [[ -e "$GLOBAL_DIR/$filename" ]]; then
                already+=("$name")
            else
                available+=("$name")
            fi
        done

        echo "Already published:"
        if [[ ${#already[@]} -eq 0 ]]; then
            echo "  (none)"
        else
            printf '  %s\n' "${already[@]}"
        fi
        echo ""
        echo "Available to publish:"
        if [[ ${#available[@]} -eq 0 ]]; then
            echo "  (none)"
        else
            printf '  %s\n' "${available[@]}"
        fi

    elif [[ "$installable" == true ]]; then
        local base_dir
        base_dir="$(resolve_project_root "$project_root_arg")"
        local local_dir="$base_dir/.claude/agents"

        [[ -d "$GLOBAL_DIR" ]] \
            || { echo "No agents in global store ($GLOBAL_DIR)"; exit 0; }

        local already=()
        local available=()
        for agent_file in "$GLOBAL_DIR"/*.md; do
            [[ -f "$agent_file" || -L "$agent_file" ]] || continue
            local filename name
            filename="$(basename "$agent_file")"
            name="${filename%.md}"
            if [[ -e "$local_dir/$filename" ]]; then
                already+=("$name")
            else
                available+=("$name")
            fi
        done

        echo "Already installed:"
        if [[ ${#already[@]} -eq 0 ]]; then
            echo "  (none)"
        else
            printf '  %s\n' "${already[@]}"
        fi
        echo ""
        echo "Available to install:"
        if [[ ${#available[@]} -eq 0 ]]; then
            echo "  (none)"
        else
            printf '  %s\n' "${available[@]}"
        fi

    else
        [[ -d "$GLOBAL_DIR" ]] \
            || { echo "No agents in global store ($GLOBAL_DIR)"; exit 0; }

        local found_any=false
        for agent_file in "$GLOBAL_DIR"/*.md; do
            [[ -f "$agent_file" || -L "$agent_file" ]] || continue
            found_any=true
            local filename name
            filename="$(basename "$agent_file")"
            name="${filename%.md}"
            if [[ -L "$agent_file" ]]; then
                printf '  %s -> %s\n' "$name" "$(readlink "$agent_file")"
            else
                printf '  %s\n' "$name"
            fi
        done

        [[ "$found_any" == true ]] || echo "No agents found in $GLOBAL_DIR"
    fi
}

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi

cmd="$1"
shift

case "$cmd" in
    publish)   cmd_publish   "$@" ;;
    install)   cmd_install   "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    list)      cmd_list      "$@" ;;
    *) echo "Error: unknown command '$cmd'" >&2; echo; usage; exit 1 ;;
esac
