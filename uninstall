#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE="$REPO_DIR/ai"
TARGET="/usr/local/bin/ai"

if [[ ! -L "$TARGET" ]]; then
    echo "Not installed: $TARGET"
    exit 0
fi

current="$(readlink "$TARGET")"
if [[ "$current" != "$SOURCE" ]]; then
    echo "Error: $TARGET points to $current, not this repo — skipping" >&2
    exit 1
fi

sudo rm "$TARGET"
echo "Uninstalled: $TARGET"
